		{
			"name": "[concat(parameters('factoryName'), '/shir-sql-server-on-prem')]",
			"type": "Microsoft.DataFactory/factories/integrationRuntimes",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "SelfHosted",
				"typeProperties": {}
