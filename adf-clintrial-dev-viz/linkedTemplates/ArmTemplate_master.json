{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-clintrial-dev-viz"
		},
		"ls_azure_databricks_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'ls_azure_databricks'"
		},
		"ls_on_prmise_metadataTable_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_on_prmise_metadataTable'"
		},
		"ls_azure_databricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "'spandan nagare's Cluster 2026-08-18 00:30:54'"
		},
		"ls_azure_key_vault_dev_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "@{concat('https://',linkedService().p_dev_key_Vault_name,'.vault.azure.net/')}"
		},
		"ls_on_prmise_metadataTable_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "@{linkedService().pLsServerName}"
		},
		"ls_on_prmise_metadataTable_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "@{linkedService().pLsDataBaseName}"
		},
		"ls_on_prmise_metadataTable_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adf_login"
		},
		"ls_source_adls_gen2_parquet_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stclintrialdevviz.dfs.core.windows.net/"
		},
		"AzureDataLakeStorage534_properties_privateLinkResourceId": {
			"type": "string",
			"defaultValue": "/subscriptions/c71a2b06-1819-428a-baaa-f7db10c2f77f/resourceGroups/rg-clin-trial-dev-viz/providers/Microsoft.Storage/storageAccounts/stclintrialdevviz"
		},
		"AzureDataLakeStorage534_properties_groupId": {
			"type": "string",
			"defaultValue": "dfs"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-clintrial-dev-viz_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_on_prmise_metadataTable_password": {
						"value": "[parameters('ls_on_prmise_metadataTable_password')]"
					},
					"ls_azure_databricks_accessToken": {
						"value": "[parameters('ls_azure_databricks_accessToken')]"
					},
					"ls_azure_key_vault_dev_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_azure_key_vault_dev_properties_typeProperties_baseUrl')]"
					},
					"ls_on_prmise_metadataTable_properties_typeProperties_server": {
						"value": "[parameters('ls_on_prmise_metadataTable_properties_typeProperties_server')]"
					},
					"ls_on_prmise_metadataTable_properties_typeProperties_database": {
						"value": "[parameters('ls_on_prmise_metadataTable_properties_typeProperties_database')]"
					},
					"ls_on_prmise_metadataTable_properties_typeProperties_userName": {
						"value": "[parameters('ls_on_prmise_metadataTable_properties_typeProperties_userName')]"
					},
					"AzureDataLakeStorage534_properties_privateLinkResourceId": {
						"value": "[parameters('AzureDataLakeStorage534_properties_privateLinkResourceId')]"
					},
					"AzureDataLakeStorage534_properties_groupId": {
						"value": "[parameters('AzureDataLakeStorage534_properties_groupId')]"
					},
					"ls_azure_databricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('ls_azure_databricks_properties_typeProperties_existingClusterId')]"
					},
					"ls_source_adls_gen2_parquet_properties_typeProperties_url": {
						"value": "[parameters('ls_source_adls_gen2_parquet_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}