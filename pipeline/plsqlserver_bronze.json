{
	"name": "plsqlserver_bronze",
	"properties": {
		"activities": [
			{
				"name": "Lkp_Src_Contro_table_Metadatta",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "@concat('select * from ',pipeline().parameters.pPLDataBaseName,'.',pipeline().parameters.pPLScehamNAme,'.',pipeline().parameters.pPLTableName,' where ' ,coalesce('Enabled',''),'=','True')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sql_server_param",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			}
		],
		"parameters": {
			"pPLserverName": {
				"type": "string",
				"defaultValue": "localhost\\SQLEXPRESS"
			},
			"pPLDataBaseName": {
				"type": "string",
				"defaultValue": "dev_clintrail_edc_src"
			},
			"pPLScehamNAme": {
				"type": "string",
				"defaultValue": "edcsrcmetadata"
			},
			"pPLTableName": {
				"type": "string",
				"defaultValue": "srcEdcClintrailToLandControl"
			}
		},
		"folder": {
			"name": "clintrial_trial_dev_source_to_bronze"
		},
		"annotations": []
	}
}